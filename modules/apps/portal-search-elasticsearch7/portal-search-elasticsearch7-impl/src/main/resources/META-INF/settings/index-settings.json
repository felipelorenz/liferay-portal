			"reverse_keyword_lowercase": {
				"filter": [
					"lowercase",
					"reverse"
				],
				"tokenizer": "keyword",
				"type": "custom"
			},
			"text_whitespace_lowercase": {
				"filter": "lowercase",
				"tokenizer": "whitespace"
			}
		},
		"filter": {
			"1_10_ngram": {
